# Copy to .env.local and fill in. Never commit .env.local.
# Values for local development come from `pnpm supabase status` after `pnpm supabase start`.

# Supabase project
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# The publishable (anon) key. Safe to expose to browsers.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-or-anon-key
# Server only. Used for private file storage. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Postgres connection used by the server. Queries run as the `authenticated`
# role under row level security. In production use the Supabase pooler URL.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_POOL_MAX=5

# Public base URL, used in auth email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# supabase (default) or local. `local` stores files under LOCAL_STORAGE_DIR and
# is refused when NODE_ENV=production.
FILE_STORAGE_DRIVER=supabase
LOCAL_STORAGE_DIR=.data/uploads

# Integration tests only (plain Postgres; the database name must contain "test").
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/quickpro_test

# Notification email (decisions.md D-039). none (default) queues emails without
# sending; log writes each one to EMAIL_LOG_DIR (development only); smtp sends
# through SMTP_URL, e.g. smtp://user:pass@smtp.example.com:587. Locally the
# Supabase inbox accepts mail at smtp://127.0.0.1:54325 (view it on :54324).
EMAIL_DRIVER=none
SMTP_URL=
EMAIL_FROM="QuickPro <notifications@quickpro.example>"
EMAIL_LOG_DIR=.data/outbox
# Optional. A scheduler calls POST /api/cron/deliver-emails with
# "Authorization: Bearer <CRON_SECRET>" to send queued emails. 32+ characters.
CRON_SECRET=

# Card payments through Stripe Connect (decisions.md D-040), test mode only:
# the app refuses live keys. Leave empty and the screens say card payments
# aren't available. From the Stripe dashboard in test mode: Developers > API
# keys (secret key), and Developers > Webhooks for the endpoint
# https://<site>/api/stripe/webhook (signing secret). If you add a second,
# "Connected accounts" endpoint for account.updated, put its secret in
# STRIPE_CONNECT_WEBHOOK_SECRET.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
# Tests only: the local Stripe stand-in, e.g. http://127.0.0.1:12111
STRIPE_API_BASE=
